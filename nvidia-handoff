    def resize_text(self, width):
        available = max(self.px(180), width - self.px(44))
        for label in self.wrap_labels:
            label.configure(wraplength=available)

    def update_button(self):
        self.cleanup_button.configure(state='disabled' if self.busy else 'normal')
        selected = self.tree.selection()
        row = self.rows.get(selected[0]) if selected else None
        record = self.selected_vm()
        self.start_button.configure(state='normal' if not self.busy and record and
            record['state'] == 'shut off' and not record.get('startup_gpu', False) else 'disabled')
        self.apply_button.configure(state='normal' if row and row[4] and not self.busy and
            row[0] != self.current_target else 'disabled')
        if row:
            self.detail.set(row[3] + (' · all GPU PCI functions configured' if row[2] == 'Virtual machine' and row[4] else ''))

    def refresh(self):
        if self.refreshing:
            return
        self.refreshing = True
        self.last_refresh = time.monotonic()
        def fetch():
            try:
                records = inventory(check_drivers=True)
                attached = pci_driver(GPU) == 'nvidia' and not load_hook().shared_nvidia_driver() and bool(nvidia_provider(providers()))
                self.messages.put(('inventory', records, attached, pci_driver(GPU)))
            except Exception as exc:
                self.messages.put(('error', str(exc)))
        threading.Thread(target=fetch, daemon=True).start()

    def show_inventory(self, records, attached, driver):
        self.refreshing = False
        self.records = records
        self.attached = attached
        owners = [d for d in records if d['live_gpu']]
        if owners:
            self.current.set('Current attachment: VM ' + ', '.join(d['name'] for d in owners))
            current = owners[0]['uuid']
        elif attached:
            self.current.set('Current attachment: Xorg — NVIDIA gaming, desktop on the primary GPU')
            current = 'xorg'
        elif driver == 'nvidia':
            self.current.set('Current attachment: CUDA without Xorg — desktop on the primary GPU')
            current = 'cuda'
        else:
            self.current.set('Current attachment: ' + ('none — idle GPU on VFIO' if driver == 'vfio-pci' else 'host; not attached to Xorg'))
            current = 'none'
        self.current_target = current
        if owners and (set(owners[0]['live_gpu']) != set(BDFS) or owners[0].get('driver_ready') is False):
            self.current_target = None
        elif current == 'none' and driver not in ('vfio-pci', 'unbound'):
            self.current_target = None
        previous = self.tree.selection()
        chosen = previous[0] if previous else current
        self.tree.delete(*self.tree.get_children())
        self.rows = {row[0]: row for row in destination_rows(records)}
        for row in self.rows.values():
            self.tree.insert('', 'end', iid=row[0], text=row[1], values=(row[2], row_summary(row, current)), tags=() if row[4] else ('unavailable',))
        if chosen in self.rows:
            self.tree.selection_set(chosen)
        self.update_button()

    def selected_vm(self):
        selected = self.tree.selection()
        return next((d for d in self.records if selected and d['uuid'] == selected[0]), None)

    def start_vm(self):
        record = self.selected_vm()
        if self.busy or not record or record['state'] != 'shut off' or record.get('startup_gpu', False):
            return
        self.process = subprocess.Popen(program_command('start-vm', record['uuid'], '--without-gpu'), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        self.starting = record['name']
        self.job = None
        self.busy = True
        self.progress.set('Starting ' + self.starting + ' without GPU…')
        self.update_button()

    def apply(self):
        from tkinter import messagebox
        selected = self.tree.selection()
        if not selected or self.busy:
            return
        target = selected[0]
        if target == self.current_target:
            return
        try:
            stops, restart = operation_plan(target, self.records, getattr(self, 'attached', False))
        except Exception as exc:
            messagebox.showerror('Cannot switch GPU', str(exc), parent=self.root)
            return
        label = self.rows[target][1]
        vm_target = target not in ('none', 'xorg', 'cuda')
        changes = ['Attach GPU to: ' + label + '.']
        if vm_target:
            changes.append('Prepare missing GPU templates, PCI controllers and guest-agent channel in the selected VM definition. Ordinary starts remain GPU-free.')
            changes.append('Use the existing QEMU guest agent to verify Debian 12/13 and install missing NVIDIA drivers. If needed, add NVIDIA’s signed APT repository and reboot this guest once. This accepts the NVIDIA driver license.')
            changes.append('Guest package changes affect /etc/apt, /usr, /lib, /boot and /var (APT, dpkg and DKMS); the VM definition is saved by libvirt under /etc/libvirt/qemu. Host integration may use /etc/libvirt/hooks/qemu.d, /etc/X11/xorg.conf.d and /etc/wireplumber, and /run for handoff safety state.')
        if stops:
            changes.append('VMs to shut down gracefully: ' + ', '.join(d['name'] for d in stops) + '.')
        if restart:
            changes.append('Graphical sessions will end. Save your work before continuing.')
        if target not in ('none', 'xorg', 'cuda') and stops:
            changes.append('The selected VM will start after the GPU is released.')
        if not messagebox.askokcancel('Switch GPU', '\n\n'.join(changes), parent=self.root):
            return
        self.job = str(uuid.uuid4())
        args = ['/usr/bin/pkexec', '--disable-internal-agent', *program_command('select', target, '--job-id', self.job)]
        if vm_target:
            args.append('--prepare-vm')
        if stops:
            args.append('--shutdown-owner')
        if restart:
            args.append('--restart-session')
        self.process = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        self.busy = True
        self.progress.set('Waiting for administrator authentication…')
        self.update_button()

    def cleanup(self):
        from tkinter import messagebox
        if self.busy or not messagebox.askokcancel(
                'Full cleanup', 'Remove NVIDIA handoff and its integration files?\n\n'
                'VMs will keep their GPU-free startup settings. Running VMs will not be stopped. '
                'Cleanup refuses while the GPU is in use. Host sound may need a new login.\n\n'
                'This also removes the program itself.', parent=self.root):
            return
        self.cleaning = self.busy = True
        self.job = None
        self.process = subprocess.Popen(['/usr/bin/pkexec', '--disable-internal-agent',
            *program_command('--cleanup', '--yes')],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        self.progress.set('Waiting for administrator authentication…')
        self.update_button()

    def poll(self):
        from tkinter import messagebox
        while True:
            try:
                message = self.messages.get_nowait()
            except queue.Empty:
                break
            if message[0] == 'inventory':
                self.show_inventory(*message[1:])
            else:
                self.refreshing = False
                self.progress.set('Could not refresh the list: ' + message[1])
        if self.process is not None and self.process.poll() is not None:
            _, error = self.process.communicate()
            code = self.process.returncode
            self.process = None
            if self.starting is not None:
                name, self.starting = self.starting, None
                self.busy = False
                self.progress.set(('Could not start ' + name + ': ' + error.strip()) if code else name + ' started without GPU.')
                self.update_button()
                self.refresh()
                if code:
                    messagebox.showerror('VM start failed', error.strip(), parent=self.root)
            elif self.cleaning:
                self.cleaning = self.busy = False
                if not code:
                    messagebox.showinfo('Full cleanup', 'NVIDIA handoff has been removed. Log in again to restore HDMI audio monitoring.', parent=self.root)
                    self.root.destroy()
                    return
                messagebox.showerror('Cleanup stopped', error.strip(), parent=self.root)
                self.progress.set('Cleanup stopped: ' + error.strip())
                self.update_button()
            elif code:
                self.busy = False
                self.progress.set('Switching did not start: ' + error.strip())
                self.update_button()
            else:
                self.progress.set('GPU switching started…')
        progress_file = status_file(os.getuid(), self.job) if self.busy and self.job else None
        if progress_file and progress_file.exists():
            try:
                data = json.loads(progress_file.read_text())
                if data.get('job') == self.job:
                    self.progress.set(data['message'])
                    if data['state'] in ('done', 'error'):
                        progress_file.unlink(missing_ok=True)
                        self.busy = False
                        self.update_button()
                        self.refresh()
                        if data['state'] == 'error' and self.shown_error != self.job:
                            self.shown_error = self.job
                            messagebox.showerror('GPU switching stopped', data['message'], parent=self.root)
            except (OSError, ValueError, KeyError):
                pass
        if not self.busy and not self.refreshing and time.monotonic() - self.last_refresh >= 4:
            self.refresh()
        self.root.after(300, self.poll)


