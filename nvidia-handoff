def make_config_directory(path):
    """New system configuration directories must remain readable under umask 077."""
    missing = []
    current = path
    while not current.exists():
        missing.append(current)
        current = current.parent
    for current in reversed(missing):
        current.mkdir(mode=0o755)
        current.chmod(0o755)


def audio_monitor_policy(config):
    """Keep the displayless GPU's HDMI audio available for safe PCI handoff.

    WirePlumber otherwise keeps ALSA control FDs open even with no HDMI sink.
    Do not disable busy checks or stop audio services from a libvirt hook.
    """
    devices = [d for d in config['devices'] if d['class'] == '0x040300']
    if not devices or not shutil.which('wireplumber'):
        return []
    version = run('/usr/bin/wireplumber', '--version')
    match = re.search(r'(?:libwireplumber|WirePlumber)\s+(\d+)\.(\d+)\.(\d+)', version, re.I)
    if not match:
        raise Error('Cannot determine WirePlumber version for NVIDIA HDMI audio policy')
    numbers = tuple(map(int, match.groups()))
    if numbers < (0, 4, 7):
        raise Error('WirePlumber 0.4.7 or newer is needed to exclude the selected HDMI audio device safely')
    names = ['alsa_card.pci-' + d['bdf'].replace(':', '_') for d in devices]
    suffix = config['gpu'].replace(':', '_').replace('.', '_')
    if numbers >= (0, 5, 0):
        rules = [{'matches': [{'device.name': name}],
                  'actions': {'update-props': {'device.disabled': True}}} for name in names]
        path = Path('/etc/wireplumber/wireplumber.conf.d') / ('51-nvidia-handoff-' + suffix + '.conf')
        data = '# Managed by nvidia-handoff: selected displayless GPU HDMI audio only.\n'
        data += 'monitor.alsa.rules = ' + json.dumps(rules, indent=2) + '\n'
    else:
        path = Path('/etc/wireplumber/main.lua.d') / ('51-nvidia-handoff-' + suffix + '.lua')
        data = '-- Managed by nvidia-handoff: selected displayless GPU HDMI audio only.\n'
        for name in names:
            data += ('table.insert(alsa_monitor.rules, {\n'
                     '  matches = { { { "device.name", "equals", ' + json.dumps(name) + ' } } },\n'
                     '  apply_properties = { ["device.disabled"] = true },\n'
                     '})\n')
    return [(path, data.encode())]


HOOK = b'#!/bin/sh\ncase "$2:$3" in\n    prepare:begin|release:end) exec /usr/bin/python3 -I /opt/nvidia-handoff --libvirt-hook "$@" ;;\n    *) exit 0 ;;\nesac\n'
XORG_OFF = b'Section "ServerFlags"\n    Option "AutoAddGPU" "off"\nEndSection\n'


def digest(data):
    return hashlib.sha256(data).hexdigest()


RECEIPT = re.compile(rb'(?m)^(?:#|--) nvidia-handoff sha256=([0-9a-f]{64}) original=(absent|on|off)\n')


def marked(data, original='absent'):
    prefix = b'--' if data.startswith(b'--') else b'#'
    marker = prefix + b' nvidia-handoff sha256=' + digest(data).encode() + b' original=' + original.encode() + b'\n'
    if data.startswith(b'#!'):
        first, rest = data.split(b'\n', 1)
        return first + b'\n' + marker + rest
    return marker + data


def receipt(path):
    validate_root_file(path)
    data = path.read_bytes()
    matches = list(RECEIPT.finditer(data))
    if not matches:
        if b'nvidia-handoff sha256=' in data:
            raise Error('Invalid ownership receipt: ' + str(path))
        return data, None
    body = RECEIPT.sub(b'', data)
    if len(matches) != 1 or b'nvidia-handoff sha256=' in body or digest(body).encode() != matches[0][1]:
        raise Error('Preserving administrator-modified file: ' + str(path))
    return body, matches[0][2].decode()


def hook_path():
    found = []
    try:
        for path in Path('/etc/libvirt/hooks/qemu.d').glob('*'):
            if path.is_symlink() or not path.is_file():
                continue
            # Ignore unrelated hooks without assuming their contents are ours.
            if b'/opt/nvidia-handoff --libvirt-hook' not in path.read_bytes():
                continue
            body, original = receipt(path)
            if body != HOOK or original not in (None, 'absent'):
                raise Error('Preserving administrator-modified hook: ' + str(path))
            found.append(path)
    except PermissionError:
        pass  # Unprivileged inventory never needs to inspect a private hook directory.
    if len(found) > 1:
        raise Error('Duplicate NVIDIA handoff hooks; resolve them before switching')
    return found[0] if found else Path('/etc/libvirt/hooks/qemu.d/50-nvidia-handoff')


def check_managed(path, data):
    if not path.exists() and not path.is_symlink():
        return
    body, original = receipt(path)
    if body != data:
        raise Error('Preserving administrator-modified file: ' + str(path))


def write_file(path, data, mode=0o644):
    import tempfile
    make_config_directory(path.parent)
    if path.exists() or path.is_symlink():
        validate_root_file(path)
    st = path.parent.lstat()
    if st.st_uid != 0 or st.st_mode & 0o022 or not stat.S_ISDIR(st.st_mode):
        raise Error('Unsafe directory: ' + str(path.parent))
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.nvidia-handoff-', delete=False) as f:
        tmp = Path(f.name)
        try:
            os.fchmod(f.fileno(), mode)
            f.write(data); f.flush(); os.fsync(f.fileno())
            os.replace(tmp, path)
        finally:
            tmp.unlink(missing_ok=True)


def refresh_hooks():
    for daemon in ('virtqemud.service', 'libvirtd.service'):
        if run('/usr/bin/systemctl', 'show', daemon, '-p', 'ActiveState', '--value') == 'active':
            run('/usr/bin/systemctl', 'kill', '--kill-whom=main', '--signal=HUP', daemon)


def ensure_integration(vm=False):
    """Called only by an explicit switching/setup action, never by GUI/status."""
    h = load_hook()
    desired = []
    if not CONFIG.exists():
        desired.append((CONFIG, XORG_OFF, 0o644))
    if vm:
        desired.extend((p, data, 0o644) for p, data in audio_monitor_policy(SETTINGS))
        desired.append((Path(SETTINGS['hook_path']), HOOK, 0o755))
    for path, data, _ in desired:
        check_managed(path, data)
    needed = [(p, data, mode) for p, data, mode in desired
              if not p.exists() or p.read_bytes() != marked(data)]
    if not needed:
        return
    fd = h.lock()
    try:
        for path, data, mode in needed:
            check_managed(path, data)
            write_file(path, marked(data), mode)
    finally:
        os.close(fd)
    if any(str(p) == SETTINGS['hook_path'] for p, _, _ in needed):
        refresh_hooks()


def status_file(uid, job):
    if uid <= 0 or str(uuid.UUID(job)) != job:
        raise Error('Invalid progress owner or job ID')
    runtime = Path('/run/user') / str(uid)
    st = runtime.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or st.st_mode & 0o022:
        raise Error('Unsafe user runtime directory')
    return runtime / ('nvidia-handoff-' + job + '.json')


def leftover_progress():
    files = []
    for runtime in Path('/run/user').iterdir():
        if not runtime.name.isdigit() or runtime.name == '0':
            continue
        st = runtime.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != int(runtime.name) or st.st_mode & 0o022:
            continue
        for path in runtime.glob('nvidia-handoff-*.json'):
            try:
                job = path.name[len('nvidia-handoff-'):-len('.json')]
                if str(uuid.UUID(job)) != job:
                    continue
                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd) as source:
                    st = os.fstat(source.fileno())
                    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_size > 65536:
                        continue
                    data = json.load(source)
                if isinstance(data, dict) and data.get('gpu') == GPU and data.get('job') == job:
                    files.append(path)
            except (OSError, ValueError, TypeError):
                continue
    return files


def redundant_files():
    """Only known artifacts from earlier versions; never recurse into unknown files."""
    files, directories = [], []
    groups = {
        Path('/opt/nvidia-handoff-portable'): {'nvidia-handoff', 'nvidia_handoff_core.py', 'README.md', 'test_portable.py'},
        Path('/opt/nvidia-handoff-backup'): {'50-omm-gpu-handoff', 'nvidia-handoff', 'nvidia-handoff.before-optional',
            'nvidia-handoff.json', 'nvidia_handoff_core.py', 'nvidia_handoff_core.py.before-optional'},
        Path('/var/lib/nvidia-handoff/optional-backups'): None,
    }
    for directory, names in groups.items():
        if not directory.exists() and not directory.is_symlink():
            continue
        st = directory.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise Error('Unsafe artifact directory: ' + str(directory))
        for path in directory.iterdir():
            known = path.name in names if names is not None else bool(re.fullmatch(
                r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\.xml', path.name))
            if not known:
                raise Error('Unexpected file; preserving artifact directory: ' + str(path))
            validate_root_file(path)
            files.append(path)
        directories.append(directory)
    for path in (Path('/opt/nvidia-handoff-portable.tar.gz'), Path('/run/gpu-xorg-status.json'),
                 Path('/run/nvidia-handoff-host.json')):
        if path.exists() or path.is_symlink():
            validate_root_file(path)
            files.append(path)
    for link in (Path('/opt/gpu-xorg'), Path('/usr/local/bin/nvidia-handoff')):
        if link.is_symlink() and os.readlink(link) == '/opt/nvidia-handoff':
            if link.lstat().st_uid != 0:
                raise Error('Unexpected symlink owner: ' + str(link))
            files.append(link)
        elif link.exists() or link.is_symlink():
            raise Error('Preserving unexpected file: ' + str(link))
    return files, directories


def remove_files(files, directories):
    for path in files:
        path.unlink(missing_ok=True)
    for directory in directories:
        if directory.exists() and not any(directory.iterdir()):
            directory.rmdir()


def cleanup_blockers(h):
    require_stopped()  # All libvirt calls are outside the GPU lock.
    if run('/usr/bin/systemctl', 'show', UNIT, '-p', 'ActiveState', '--value') in ('active', 'activating', 'deactivating'):
        raise Error('A GPU switching job is active; wait for it to finish.')
    if (h.STATE_DIR / 'xorg-transition').exists() or (h.STATE_DIR / 'uninstalling').exists():
        raise Error('An unfinished GPU transition exists; finish/recover it first.')
    cleanup_devices(h)
    state = h.load()
    if state is not None:
        h.assert_claim(state)


def cleanup_devices(h):
    h.topology()
    h.display_idle()
    if xorg_owners(h):
        raise Error('GPU is attached to Xorg. Disconnect it before full cleanup.')
    pid = run('/usr/bin/systemctl', 'show', h.SERVICE, '-p', 'MainPID', '--value')
    h.idle(h.host_nodes() | h.vfio_nodes(), ignored_pids=(int(pid),) if pid.isdigit() and int(pid) else ())


def cleanup(args):
    if os.geteuid() != 0:
        raise Error('Run full cleanup as administrator (use --dry-run to preview).')
    h = load_hook()
    files, directories = redundant_files()
    files.extend(leftover_progress())
    integrations = {}
    original_mode = None
    suffix = GPU.replace(':', '_').replace('.', '_')
    candidates = [CONFIG, Path(SETTINGS['hook_path'])]
    candidates.extend(Path('/etc/wireplumber') / folder / ('51-nvidia-handoff-' + suffix + ext)
                      for folder, ext in (('wireplumber.conf.d', '.conf'), ('main.lua.d', '.lua')))
    for path in candidates:
        if not path.exists() and not path.is_symlink():
            continue
        body, original = receipt(path)
        if original is None:
            if path != CONFIG:
                raise Error('Unmarked integration requires explicit installer migration: ' + str(path))
            continue  # A preexisting user Xorg policy belongs to the user.
        integrations[str(path)] = digest(path.read_bytes())
        if path == CONFIG and original != 'absent':
            original_mode = original
        else:
            files.append(path)
    for path in (Path('/opt/nvidia-handoff'), Path('/opt/nvidia_handoff_core.py')):
        validate_root_file(path)
        files.append(path)
    if h.STATE_DIR.exists():
        st = h.STATE_DIR.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
            raise Error('Unsafe runtime directory')
        for path in h.STATE_DIR.iterdir():
            if path.name not in ('lock', 'state.json', 'destination.json', 'xorg-transition', 'uninstalling'):
                raise Error('Unexpected runtime file: ' + str(path))
            validate_root_file(path)
    guests = []
    if shutil.which('virsh'):
        for ident in virsh('list', '--all', '--uuid').split():
            if str(uuid.UUID(ident)) != ident:
                raise Error('Invalid domain UUID')
            if not re.search(r'^Persistent:\s+yes$', virsh('dominfo', ident), re.M):
                continue
            xml = virsh('dumpxml', '--inactive', ident)
            changed = h.disable_optional_xml(xml)
            if changed is not None:
                guests.append((ident, xml, changed))
    print('Remove:\n' + '\n'.join(str(p) for p in files), flush=True)
    print('Remove handoff metadata from VM definitions (keep GPU-free startup): ' + (', '.join(ET.fromstring(x).findtext('name') for _, x, _ in guests) or 'none'), flush=True)
    print('Restore host GPU bindings and original AutoAddGPU setting; remove runtime state. VM power states remain unchanged.', flush=True)
    print('Private home directories are not inspected. System journal history is retained.', flush=True)
    if args.dry_run:
        try:
            cleanup_blockers(h)
        except Exception as exc:
            print('Currently blocked: ' + str(exc), flush=True)
        return
    cleanup_blockers(h)  # Refuse before creating even a lock or marker.
    if not args.yes and (not sys.stdin.isatty() or input('Remove NVIDIA handoff completely? Type REMOVE: ') != 'REMOVE'):
        raise Error('Cleanup cancelled; use --yes for an explicitly confirmed noninteractive removal.')
    fd = h.lock()
    marker = h.STATE_DIR / 'uninstalling'
    restored = []
    try:
        # Recheck users without querying libvirt while locked.
        cleanup_devices(h)
        h.atomic_json(marker, {'pid': os.getpid()})
        restore_host(h)
        os.close(fd)
        fd = None
        # No libvirt calls under our lock: hooks can acquire it and reject GPU starts via marker.
        for ident, old, changed in guests:
            current = virsh('dumpxml', '--inactive', ident)
            if ET.tostring(ET.fromstring(current)) != ET.tostring(ET.fromstring(old)):
                raise Error('VM configuration changed during cleanup; retry: ' + ident)
            virsh_input(changed, 'define', '/dev/stdin', '--validate')
            restored.append((ident, old, changed))
        fd = h.lock(cleaning=True)
        for name, expected in integrations.items():
            if Path(name).exists() and digest(Path(name).read_bytes()) != expected:
                raise Error('Integration changed during cleanup: ' + name)
        if original_mode is not None:
            body, _ = receipt(CONFIG)
            data = re.sub(rb'(?im)^(\s*Option\s+"AutoAddGPU"\s+")(?:on|off)("\s*)$',
                          lambda m: m[1] + original_mode.encode() + m[2], body)
            write_file(CONFIG, data, stat.S_IMODE(CONFIG.stat().st_mode))
        # Removing the program invalidates queued workers before the lock disappears.
        remove_files(files, directories)
        for parent in {Path(name).parent for name in integrations if name.startswith('/etc/wireplumber/')} :
            if parent.exists() and not parent.is_symlink() and not any(parent.iterdir()):
                parent.rmdir()
        for path in h.STATE_DIR.iterdir():
            path.unlink()
        h.STATE_DIR.rmdir()
        parent = Path('/var/lib/nvidia-handoff')
        if parent.exists() and not parent.is_symlink() and not any(parent.iterdir()):
            parent.rmdir()
        print('Full cleanup complete. Log in again to restore HDMI audio monitoring.', flush=True)
    except BaseException:
        if fd is not None:
            os.close(fd)
            fd = None
        # Restore VM metadata on a pre-removal failure, outside the GPU lock.
        if Path('/opt/nvidia-handoff').exists():
            for ident, old, changed in reversed(restored):
                current = virsh('dumpxml', '--inactive', ident)
                if ET.tostring(ET.fromstring(current)) == ET.tostring(ET.fromstring(changed)):
                    virsh_input(old, 'define', '/dev/stdin', '--validate')
            marker.unlink(missing_ok=True)
        raise
    finally:
        if fd is not None:
            os.close(fd)


def install(argv):
    """Install code; explicitly migrate a legacy manifest without touching devices."""
    import ast
    parser = argparse.ArgumentParser(description='Install stateless secondary NVIDIA handoff')
    parser.add_argument('--gpu', help='PCI BDF when multiple eligible NVIDIA GPUs exist')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--optional-gpu', action='store_true', help='Enable optional GPU cold boot and hotplug')
    args = parser.parse_args(argv)
    if os.geteuid() != 0 and not args.dry_run:
        raise Error('Install with sudo /usr/bin/python3 -I ./nvidia-handoff --install')
    h = load_core(trusted=False)
    h.assert_x11()
    if not Path('/run/systemd/system').is_dir():
        raise Error('This installer requires Debian with systemd/logind.')
    for command in ('modprobe', 'modinfo', 'systemctl', 'systemd-run', 'loginctl', 'udevadm'):
        if not shutil.which(command, path='/usr/sbin:/usr/bin:/sbin:/bin'):
            raise Error('Missing required system command: ' + command)
    config = h.discover(args.gpu)
    config['hook_path'] = str(hook_path())
    previous = None
    migration = []
    if LEGACY_CONFIG.exists() or LEGACY_CONFIG.is_symlink():
        validate_root_file(LEGACY_CONFIG)
        previous = json.loads(LEGACY_CONFIG.read_text())
        identity = lambda c: {(d['bdf'], d['vendor'], d['device']) for d in c['devices']}
        if previous['gpu'] != config['gpu'] or identity(previous) != identity(config):
            raise Error('Legacy manifest belongs to different hardware; refusing migration')
        runtime = Path(previous['state_dir'])
        if not (str(runtime) == '/run/nvidia-handoff/' + config['gpu'] or
                runtime.parent == Path('/run') and re.fullmatch(r'[A-Za-z0-9_-]+-gpu-handoff', runtime.name)):
            raise Error('Unrecognized legacy runtime directory')
        if previous['xorg_config'] != config['xorg_config'] or previous['hook_path'] != config['hook_path']:
            raise Error('Legacy integration paths differ from live discovery; review before migration')
        config['state_dir'] = str(runtime)
        suffix = config['gpu'].replace(':', '_').replace('.', '_')
        allowed = {config['hook_path'], config['xorg_config']}
        allowed.update('/etc/wireplumber/' + folder + '/51-nvidia-handoff-' + suffix + ext
                       for folder, ext in (('wireplumber.conf.d', '.conf'), ('main.lua.d', '.lua')))
        for name, expected in previous.get('managed_files', {}).items():
            if name not in allowed:
                raise Error('Unrecognized legacy managed path: ' + name)
            path = Path(name)
            if path.exists() or path.is_symlink():
                validate_root_file(path)
                body = path.read_bytes()
                if digest(body) != expected:
                    raise Error('Preserving administrator-modified file: ' + name)
                migration.append((path, marked(body), stat.S_IMODE(path.stat().st_mode)))
        xorg = Path(config['xorg_config'])
        if xorg.exists() and str(xorg) not in previous.get('managed_files', {}):
            validate_root_file(xorg)
            modes = re.findall(rb'(?im)^\s*Option\s+"AutoAddGPU"\s+"(off|on)"\s*$', xorg.read_bytes())
            original = previous.get('xorg_original_mode')
            if len(modes) != 1 or modes[0].decode().lower() != previous.get('xorg_applied_mode') or original not in ('off', 'on'):
                raise Error('Legacy Xorg restoration record does not match live policy')
            migration.append((xorg, marked(xorg.read_bytes(), original), stat.S_IMODE(xorg.stat().st_mode)))
    h.configure(config)
    h.topology()
    h.load()  # Validate active recovery state without recovering or rebinding.
    print('Live hardware and integration discovery:\n' + json.dumps(config, indent=2), flush=True)
    print('Install /opt/nvidia-handoff and /opt/nvidia_handoff_core.py.', flush=True)
    for path, _, _ in migration:
        print('Add ownership/restoration receipt: ' + str(path), flush=True)
    if previous:
        print('Remove legacy manifest: ' + str(LEGACY_CONFIG), flush=True)
        if h.STATE_DIR.exists():
            print('Tag existing GPU lock: ' + str(h.STATE_DIR / 'lock'), flush=True)
    if args.dry_run:
        return
    source = Path(__file__).resolve()
    core = source.with_name('nvidia_handoff_core.py').read_bytes()
    app = source.read_bytes()
    ast.parse(core); ast.parse(app)
    expected_migration = {path: digest(path.read_bytes()) for path, _, _ in migration}
    changes = []
    fd = h.lock(installing=True) if h.STATE_DIR.exists() else None
    try:
        if previous and json.loads(LEGACY_CONFIG.read_text()) != previous:
            raise Error('Legacy manifest changed during migration')
        for path, expected in expected_migration.items():
            validate_root_file(path)
            if digest(path.read_bytes()) != expected:
                raise Error('Integration changed during migration: ' + str(path))
        targets = [(Path('/opt/nvidia_handoff_core.py'), core, 0o644),
                   (Path('/opt/nvidia-handoff'), app, 0o755), *migration]
        for path, data, mode in targets:
            old = None
            if path.exists() or path.is_symlink():
                validate_root_file(path)
                old = (path.read_bytes(), stat.S_IMODE(path.stat().st_mode))
            changes.append((path, old))
            write_file(path, data, mode)
        if previous:
            # Remove only the exact manifest that was reviewed before acquiring the lock.
            if json.loads(LEGACY_CONFIG.read_text()) != previous:
                raise Error('Legacy manifest changed during migration')
            LEGACY_CONFIG.unlink()
    except BaseException:
        for path, old in reversed(changes):
            if old is None:
                path.unlink(missing_ok=True)
            else:
                write_file(path, old[0], old[1])
        raise
    finally:
        if fd is not None:
            os.close(fd)
    print('Installed. No GPU bindings, running guests or graphical sessions changed.', flush=True)
    if args.optional_gpu:
        print(run('/usr/bin/python3', '-I', '/opt/nvidia-handoff', '--gpu', config['gpu'], 'enable-optional'), flush=True)


def hook_gpu(h, xml):
    root = ET.fromstring(xml)
    slots = set()
    for a in root.findall('./devices/hostdev[@type="pci"]/source/address'):
        bdf = '%04x:%02x:%02x.%x' % tuple(int(a.get(k, '0'), 0) for k in ('domain', 'bus', 'slot', 'function'))
        slots.add(bdf.rsplit('.', 1)[0])
    candidates = [p.name for p in h.pci_gpu_devices()
                  if p.name.rsplit('.', 1)[0] in slots and h.read_attr(p / 'vendor') == '0x10de']
    if len(candidates) > 1:
        raise Error('More than one NVIDIA GPU in hook XML; refusing ambiguous handoff')
    return candidates[0] if candidates else None


def main(argv):
    if argv[:1] == ['--install']:
        return install(argv[1:])
    if argv[:1] == ['--probe']:
        h = load_core(trusted=False)
        h.assert_x11()
        print(json.dumps(h.discover(argv[1] if len(argv) > 1 else None), indent=2))
        return
    gpu = manager = None
    while argv and argv[0] in ('--gpu', '--display-manager'):
        if len(argv) < 2:
            raise Error('Missing value for ' + argv[0])
        if argv[0] == '--gpu':
            gpu = argv[1]
        else:
            manager = argv[1]
            if not re.fullmatch(r'[A-Za-z0-9_.@-]+\.service', manager):
                raise Error('Invalid display manager unit')
        argv = argv[2:]
    if argv[:1] == ['--libvirt-hook']:
        args = argv[1:]
        if len(args) < 4 or tuple(args[1:3]) not in (('prepare', 'begin'), ('release', 'end')):
            return 0
        xml = sys.stdin.read()
        h = load_core()
        gpu = hook_gpu(h, xml)
        if gpu is None:
            return 0
        initialize(gpu)
        return load_hook().main(args, xml)
    initialize(gpu, manager)
    if argv[:1] == ['--cleanup']:
        parser = argparse.ArgumentParser(description='Remove NVIDIA handoff and restore its integration changes')
        parser.add_argument('--dry-run', action='store_true', help='Show files, VM restoration and blockers without changing anything')
        parser.add_argument('--yes', action='store_true', help='Confirm full removal')
        return cleanup(parser.parse_args(argv[1:]))
    if argv[:1] == ['enable-optional']:
        return enable_optional_guests()
    if argv[:1] == ['start-vm']:
        parser = argparse.ArgumentParser(description='Start a VM with a one-time GPU configuration')
        parser.add_argument('vm')
        parser.add_argument('--without-gpu', action='store_true', help='Start without claiming or attaching the selected GPU')
        args = parser.parse_args(argv[1:])
        try:
            ident = str(uuid.UUID(args.vm))
        except ValueError:
            ident = virsh('domuuid', args.vm)
        return start_optional(ident, without_gpu=args.without_gpu)
    if argv[:1] == ['--recover']:
        return load_hook().main(argv)
    if argv in (['gui'], ['--gui']):
        return gui()
    if argv[:1] in (['select'], ['--selection-worker']):
        parser = argparse.ArgumentParser()
        parser.add_argument('mode')
        parser.add_argument('target')
        parser.add_argument('--job-id', default=None)
        parser.add_argument('--status-uid', type=int)
        parser.add_argument('--shutdown-owner', action='store_true')
        parser.add_argument('--restart-session', action='store_true')
        parser.add_argument('--prepare-vm', action='store_true', help='Authorize VM hardware setup, Debian driver packages and one guest reboot if required')
        # Internal worker uses an option-shaped token; remove it before argparse.
        args = parser.parse_args((['worker'] + argv[1:]) if argv[0] == '--selection-worker' else argv)
        job = args.job_id or str(uuid.uuid4())
        global OP_STATUS
        if args.status_uid is not None:
            if args.mode != 'worker' or os.geteuid() != 0:
                raise Error('Internal progress option requires root worker')
            OP_STATUS = status_file(args.status_uid, job)
        fn = selection_worker if args.mode == 'worker' else select_destination
        return fn(args.target, job, args.shutdown_owner, args.restart_session, args.prepare_vm)
    if len(argv) == 2 and argv[0] == '--worker' and argv[1] in ('connect', 'disconnect'):
        return worker(argv[1])
    if argv[:1] == ['run']:
        return launch(argv[1:])
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('mode', choices=('status', 'connect', 'disconnect', 'run', 'gui'), nargs='?', default='status')
    parser.add_argument('--restart-session', action='store_true', help='Allow login manager restart and logout of graphical sessions')
    args = parser.parse_args(argv)
    if args.mode == 'status':
        status()
    elif args.mode == 'gui':
        gui()
    else:
        switch(args.mode, args.restart_session)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except Exception as exc:
        print('nvidia-handoff:', exc, file=sys.stderr, flush=True)
        sys.exit(1)
