#!/usr/bin/python3 -I
"""Safely hand off a displayless secondary NVIDIA GPU to CUDA, X11 or libvirt.

connect/disconnect require --restart-session: the login manager restarts and logs out users.
GUI can request graceful VM shutdown after confirmation.
VM startup: start-vm NAME [--without-gpu].
Full uninstall: --cleanup [--dry-run] [--yes].
Debian with systemd, NVIDIA driver and X.Org or XLibre; Wayland is refused.
"""
import argparse
import hashlib
import json
import queue
import threading
import uuid
import xml.etree.ElementTree as ET
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time
import types
import shutil

SETTINGS_PATH = Path('/etc/nvidia-handoff.json')
SETTINGS = {}
BDFS = ()
GPU = None
LABEL = 'NVIDIA GPU'
UNIT = 'nvidia-handoff.service'
CONFIG = None
OP_STATUS = None


class Error(RuntimeError):
    pass


def run(*args):
    p = subprocess.run(args, stdin=subprocess.DEVNULL, capture_output=True,
                       text=True, timeout=35, env={**os.environ, 'LC_ALL': 'C'})
    if p.returncode:
        raise Error(p.stderr.strip() or f'{args[0]} failed ({p.returncode})')
    return p.stdout.strip()


def initialize():
    global SETTINGS, BDFS, GPU, LABEL, CONFIG
    validate_root_file(SETTINGS_PATH)
    SETTINGS = json.loads(SETTINGS_PATH.read_text())
    h = load_core()
    h.configure(SETTINGS)
    BDFS, GPU = h.DEVICES, h.GPU
    LABEL, CONFIG = SETTINGS.get('label', 'NVIDIA GPU'), h.XORG_CONFIG


def validate_root_file(path):
    for p in (path.parent, path):
        st = p.lstat()
        if st.st_uid != 0 or st.st_mode & 0o022 or stat.S_ISLNK(st.st_mode):
            raise Error('Unsafe ownership/permissions: ' + str(p))
    if not path.is_file():
        raise Error('Expected regular file: ' + str(path))


def load_core(trusted=True):
    path = Path(__file__).resolve().with_name('nvidia_handoff_core.py')
    if trusted:
        validate_root_file(path)
    h = types.ModuleType('nvidia_handoff_core')
    exec(compile(path.read_bytes(), str(path), 'exec'), h.__dict__)
    return h


def require_stopped():
    owners = [d['name'] for d in inventory() if d['live_gpu']]
    if owners:
        raise Error('GPU belongs to active VM: ' + ', '.join(owners) + '. Shut it down first.')


def pci_driver(bdf):
    p = Path('/sys/bus/pci/devices') / bdf / 'driver'
    return p.resolve(strict=True).name if p.is_symlink() else 'unbound'


def providers():
    if not os.environ.get('DISPLAY'):
        raise Error('Run this command from the graphical Xorg session.')
    return run('/usr/bin/xrandr', '--listproviders')


def nvidia_provider(text):
    for line in text.splitlines():
        m = re.search(r'name:(NVIDIA[^\n]+)$', line)
        if m:
            return m.group(1).strip()
    return None


def status():
    h = load_hook()
    print(LABEL, GPU)
    print('X11 session check:', end=' ')
    h.assert_x11()
    print('passed')
    print('IOMMU isolation:', h.isolated())
    for b in BDFS:
        print(b + ':', pci_driver(b))
    for d in inventory():
        if d['pci']:
            print('VM:', d['name'], d['state'], 'eligible=' + str(d['eligible']), 'live=' + str(d['live_gpu']))
    print(CONFIG.read_text().strip() if CONFIG.exists() else 'Xorg integration not needed yet.')
    if os.environ.get('DISPLAY'):
        print(providers())


def load_hook():
    h = load_core()
    h.configure(SETTINGS)
    return h


def atomic_config(data):
    s = CONFIG.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_uid != 0 or s.st_mode & 0o022:
        raise Error('Unsafe Xorg configuration ownership/permissions')
    tmp = CONFIG.with_name('.' + CONFIG.name + '.nvidia-handoff.new')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'wb') as out:
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
            os.fchown(out.fileno(), s.st_uid, s.st_gid)
            os.fchmod(out.fileno(), stat.S_IMODE(s.st_mode))
        os.replace(tmp, CONFIG)
        SETTINGS['xorg_applied_mode'] = re.findall(rb'(?im)^\s*Option\s+"AutoAddGPU"\s+"(off|on)"\s*$', data)[0].decode().lower()
        if str(CONFIG) in SETTINGS.get('managed_files', {}):
            SETTINGS['managed_files'][str(CONFIG)] = digest(data)
        write_file(SETTINGS_PATH, (json.dumps(SETTINGS, indent=2) + '\n').encode())
    finally:
        tmp.unlink(missing_ok=True)


def xorg_processes(h):
    result = set()
    for p in h.PROC.iterdir():
        if not p.name.isdigit():
            continue
        try:
            if (p / 'comm').read_text().strip().lower() in ('xorg', 'xlibre'):
                result.add(p.name)
        except (FileNotFoundError, ProcessLookupError):
            continue
    return result


def xorg_owners(h):
    nodes = {p for p in h.host_nodes() if p.parent.name != 'snd'}
    rdevs = {p.stat().st_rdev for p in nodes}
    owners = set()
    for pid in xorg_processes(h):
        try:
            for fd in (h.PROC / pid / 'fd').iterdir():
                try:
                    s = fd.stat()
                    if stat.S_ISCHR(s.st_mode) and s.st_rdev in rdevs:
                        owners.add(pid)
                except (FileNotFoundError, ProcessLookupError):
                    continue
        except (FileNotFoundError, ProcessLookupError):
            continue
    return owners


def wait_xorg(h, old, gaming):
    deadline = time.monotonic() + 25
    while time.monotonic() < deadline:
        h.assert_x11()
        current = xorg_processes(h)
        if current and current.isdisjoint(old) and bool(xorg_owners(h)) == gaming:
            return
        time.sleep(0.5)
    raise Error('Xorg did not reach the expected GPU mode; transition interlock retained.')


def restore_host(h):
    s = h.load()
    if s is not None:
        h.release()
    if any(h.driver(b) != h.HOST[b] for b in h.DEVICES):
        # Recover manually detached, idle VFIO devices when no lifecycle state remains.
        s = h.transaction(h.snapshot())
        s['phase'] = 'vfio'
        h.save(s)
        h.restore(s)
    if any(h.driver(b) != h.HOST[b] for b in h.DEVICES):
        raise Error('Host driver binding verification failed')


def worker(mode, preserve_policy=False):
    if os.geteuid() != 0:
        raise Error('The switch worker requires administrator authentication.')
    ensure_integration()
    h = load_hook()
    h.assert_x11()
    require_stopped()  # Libvirt query OUTSIDE the GPU lock.
    fd = h.lock()
    marker = h.STATE_DIR / 'xorg-transition'
    original = None
    changed = False
    try:
        h.topology()
        h.idle(h.vfio_nodes())
        current = h.xorg_mode()
        owners = xorg_owners(h)
        wanted = 'on' if mode == 'connect' else 'off'
        if current == wanted and bool(owners) == (mode == 'connect'):
            if mode == 'connect' and not xorg_processes(h):
                raise Error('No X11 server is running.')
            marker.unlink(missing_ok=True)
            if not preserve_policy:
                h.choose_target('xorg' if mode == 'connect' else None)
            return
        if mode == 'disconnect' and h.driver(GPU) == 'nvidia' and h.shared_nvidia_driver():
            raise Error('Cannot safely distinguish X11 ownership while another NVIDIA GPU shares the host driver.')
        manager = h.display_manager()  # Resolve before changing anything.
        if mode == 'connect' and h.shared_nvidia_driver():
            raise Error('Another NVIDIA GPU shares the host driver; automatic X11 attachment is ambiguous.')
        marker.write_text(mode + '\n')
        os.chmod(marker, 0o600)
        if mode == 'connect':
            restore_host(h)
            h.run('/usr/sbin/modprobe', 'nvidia_drm')
            h.topology()  # Connectors become visible only after binding; refuse displays.
        original = CONFIG.read_bytes()
        text, count = re.subn(r'(?im)^(\s*Option\s+"AutoAddGPU"\s+")(?:off|on)("\s*)$',
                              lambda m: m.group(1) + wanted + m.group(2), original.decode())
        if count != 1:
            raise Error('Expected one AutoAddGPU off/on option')
        old = xorg_processes(h)
        atomic_config(text.encode())
        changed = True
        print('Restarting ' + manager + '; graphical sessions will end.', flush=True)
        # Marker prevents hook prepare while restart runs. Never hold the lock across a DM dependency.
        os.close(fd)
        fd = None
        h.run('/usr/bin/systemctl', 'restart', manager)
        wait_xorg(h, old, mode == 'connect')
        fd = h.lock()
        marker.unlink(missing_ok=True)
        if not preserve_policy:
            h.choose_target('xorg' if mode == 'connect' else None)
        h.log('X11 GPU mode: ' + mode)
    except BaseException:
        if fd is None:
            fd = h.lock()
        if changed and original is not None:
            atomic_config(original)
        if marker.exists():
            print('Switch failed. Configuration restored; GPU protected by transition marker. '
                  'Use disconnect --restart-session to recover.', file=sys.stderr, flush=True)
        raise
    finally:
        if fd is not None:
            os.close(fd)


def switch(mode, restart):
    if not restart:
        raise Error('This ends graphical sessions managed by the login manager. Save your work, then add --restart-session.')
    require_stopped()  # Refuse a running VM before prompting for a password.
    if os.geteuid() != 0:
        print('Administrator authentication is needed to switch Xorg mode.', flush=True)
        os.execv('/usr/bin/sudo', ['sudo', '/usr/bin/python3', '-I', str(Path(__file__).resolve()), mode, '--restart-session'])
    load_hook()  # Fail before scheduling if the installed interlock is unavailable.
    run('/usr/bin/systemd-run', '--unit=nvidia-handoff', '--collect', '--property=Type=exec',
        '/usr/bin/python3', '-I', str(Path(__file__).resolve()), '--worker', mode)
    print('Switch scheduled. The login manager will log out this session. Log: sudo journalctl -u ' + UNIT)


def launch(command):
    if os.geteuid() == 0:
        raise Error('Launch games as your normal user.')
    load_hook().assert_x11(need_display=True)
    require_stopped()
    if pci_driver(GPU) != 'nvidia':
        raise Error('GPU is not attached to the host; connect it first.')
    if load_hook().shared_nvidia_driver():
        raise Error('Multiple host NVIDIA GPUs: automatic PRIME provider selection is ambiguous.')
    provider = nvidia_provider(providers())
    if not provider:
        raise Error('No NVIDIA X11 provider. Use connect --restart-session after saving work.')
    if command[:1] == ['--']:
        command = command[1:]
    if not command:
        raise Error('Specify the game/application after /opt/nvidia-handoff run.')
    os.environ.update(__NV_PRIME_RENDER_OFFLOAD='1', __GLX_VENDOR_LIBRARY_NAME='nvidia',
                      __NV_PRIME_RENDER_OFFLOAD_PROVIDER=provider, __VK_LAYER_NV_optimus='NVIDIA_only')
    os.execvp(command[0], command)



def virsh_input(xml, *args):
    result = subprocess.run(['/usr/bin/virsh', '-c', 'qemu:///system', *args],
                            input=xml, capture_output=True, text=True, timeout=60,
                            env={**os.environ, 'LC_ALL': 'C'})
    if result.returncode:
        raise Error(result.stderr.strip() or 'libvirt operation failed')
    return result.stdout.strip()


def optional_templates(ident):
    h = load_hook()
    root = ET.fromstring(virsh('dumpxml', '--inactive', ident))
    return h, root, h.optional_devices(root)


def enable_optional_guests():
    if os.geteuid() != 0:
        raise Error('Administrator authentication required')
    h = load_hook()
    ensure_integration(vm=True)
    for ident in virsh('list', '--all', '--uuid').split():
        if str(uuid.UUID(ident)) != ident:
            raise Error('Unexpected domain UUID')
        info = virsh('dominfo', ident)
        if not re.search(r'^Persistent:\s+yes$', info, re.M):
            continue
        xml = virsh('dumpxml', '--inactive', ident)
        changed = h.enable_optional_xml(xml)
        if changed is None:
            continue
        # Outside the GPU lock and outside a libvirt hook. Live devices remain untouched.
        virsh_input(changed, 'define', '/dev/stdin', '--validate')
        print('Enabled optional GPU for ' + ET.fromstring(xml).findtext('name'), flush=True)


def mark_claim(h, ident):
    state = h.load()
    if state is None:
        raise Error('GPU reservation disappeared')
    state.update(claim_pid=os.getpid(), claim_start=h.process_start(os.getpid()), claim_uuid=ident)
    h.save(state)


def finish_claim(h):
    state = h.load()
    if state is not None and state.get('claim_pid') == os.getpid():
        for key in ('claim_pid', 'claim_start', 'claim_uuid'):
            state.pop(key, None)
        h.save(state)


def attach_running(ident):
    h, root, templates = optional_templates(ident)
    if not templates:
        raise Error('Optional GPU templates are missing')
    records = inventory()
    selected = next((d for d in records if d['uuid'] == ident), None)
    if selected is None or selected['state'] != 'running':
        raise Error('Live GPU attachment requires a running guest')
    if set(selected['live_gpu']) == set(BDFS):
        return
    fd = h.lock()
    try:
        h.assert_x11()
        if any(d['live_gpu'] for d in records if d['uuid'] != ident):
            raise Error('GPU belongs to another guest; no live attachment performed')
        if h.xorg_mode() != 'off' or (h.STATE_DIR / 'xorg-transition').exists():
            raise Error('X11 owns/reserves the GPU; no live attachment performed')
        state = h.load()
        if not (state and state.get('uuid') == ident and state['phase'] == 'vfio' and selected['live_gpu']):
            # Atomic safe claim. Busy CUDA/graphics checks run before any driver mutation.
            h.park()
            h.VM, h.UUID = selected['name'], ident
            h.choose_target(ident)
            h.prepare()
        elif any(h.driver(b) != 'vfio-pci' for b in BDFS):
            raise Error('Partial GPU assignment has unexpected driver bindings')
        mark_claim(h, ident)
    finally:
        os.close(fd)
    try:
        # Do not hold the shared GPU lock across libvirt calls.
        for dev in templates:
            live = next(d for d in inventory() if d['uuid'] == ident)['live_gpu']
            _, entries = pci_entries('<domain><devices>' + ET.tostring(dev, encoding='unicode') + '</devices></domain>')
            if entries[0][0] not in live:
                virsh_input(ET.tostring(dev, encoding='unicode'), 'attach-device', ident, '/dev/stdin', '--live')
        current = next(d for d in inventory() if d['uuid'] == ident)
        if set(current['live_gpu']) != set(BDFS):
            raise Error('Live GPU assignment did not complete')
        h.log('Optional GPU attached live to ' + selected['name'])
    except BaseException:
        current = next((d for d in inventory() if d['uuid'] == ident), None)
        if current is not None and not current['live_gpu']:
            fd = h.lock()
            try:
                h.VM, h.UUID = selected['name'], ident
                h.release()
            finally:
                os.close(fd)
        else:
            h.log('Partial live GPU attachment retained; no forced unplug. Guest remains running.', True)
        raise
    finally:
        fd = h.lock()
        try:
            finish_claim(h)
        finally:
            os.close(fd)


def start_optional(ident, without_gpu=False):
    h, root, templates = optional_templates(ident)
    if virsh('domstate', ident) != 'shut off':
        raise Error('Guest is not shut off')
    if re.search(r'^Managed save:\s+yes$', virsh('dominfo', ident), re.M):
        raise Error('VM has saved memory. Resume or discard it explicitly in virt-manager before a fresh boot.')
    xml = ET.tostring(root, encoding='unicode')
    if any(bdf in BDFS for bdf, _ in pci_entries(xml)[1]):
        raise Error('Persistent VM configuration still includes this GPU. Enable optional GPU setup first.')
    if without_gpu:
        virsh_input(h.boot_xml(xml, False) if templates else xml, 'create', '/dev/stdin', '--validate')
        return
    if not templates:
        raise Error('VM has no optional GPU template. Enable optional GPU setup first.')
    ensure_integration(vm=True)
    with_gpu = False
    fd = h.lock()
    try:
        if h.policy_target() in (None, ident) and h.xorg_mode() == 'off':
            try:
                h.park()
                h.choose_target(ident)
                mark_claim(h, ident)
                with_gpu = True
            except h.Refuse as exc:
                h.log('Cold boot without optional GPU: ' + str(exc))
    finally:
        os.close(fd)
    # createXML on an existing inactive persistent guest uses a separate live XML.
    try:
        virsh_input(h.boot_xml(xml, with_gpu), 'create', '/dev/stdin', '--validate')
    finally:
        if with_gpu:
            fd = h.lock()
            try:
                finish_claim(h)
            finally:
                os.close(fd)




def virsh(*args):
    return run('/usr/bin/virsh', '-c', 'qemu:///system', *args)


def pci_entries(xml):
    root = ET.fromstring(xml)
    entries = []
    for dev in root.findall('./devices/hostdev[@type="pci"]'):
        a = dev.find('./source/address')
        if a is not None:
            bdf = '%04x:%02x:%02x.%x' % tuple(int(a.get(k, '0'), 0) for k in ('domain', 'bus', 'slot', 'function'))
            entries.append((bdf, dev.get('managed')))
    return root, entries


def inventory():
    if not shutil.which('virsh'):
        return []
    result = []
    for ident in virsh('list', '--all', '--uuid').splitlines():
        ident = ident.strip()
        if not ident:
            continue
        if str(uuid.UUID(ident)) != ident:
            raise Error('Unexpected libvirt domain UUID')
        # Transient domains have no persistent XML.
        info = dict(line.split(':', 1) for line in virsh('dominfo', ident).splitlines() if ':' in line)
        persistent = info.get('Persistent', '').strip() == 'yes'
        root, entries = pci_entries(virsh('dumpxml', '--inactive', ident) if persistent else virsh('dumpxml', ident))
        state = virsh('domstate', ident)
        _, live = pci_entries(virsh('dumpxml', ident)) if state != 'shut off' else (None, [])
        h = load_hook() if SETTINGS else None
        optional = h.optional_devices(root) if h is not None else []
        if optional:
            _, candidates = pci_entries('<domain><devices>' + ''.join(ET.tostring(d, encoding='unicode') for d in optional) + '</devices></domain>')
        else:
            candidates = entries
        target = [entry for entry in candidates if entry[0] in BDFS]
        result.append({'uuid': ident, 'name': root.findtext('name'), 'state': state,
                       'optional': bool(optional), 'startup_gpu': any(bdf in BDFS for bdf, _ in entries), 'pci': bool(entries or optional), 'eligible': len(target) == len(BDFS) and
                       {e[0] for e in target} == set(BDFS) and all(e[1] in (None, 'no', 'yes') for e in target),
                       'live_gpu': [e[0] for e in live if e[0] in BDFS]})
    return result


def destination_rows(records):
    rows = [('none', 'None', 'Idle GPU', 'Leave GPU idle, without a VM or Xorg', True),
            ('cuda', 'CUDA without Xorg', 'Compute', 'NVIDIA + UVM for CUDA; desktop stays on the primary GPU', True),
            ('xorg', 'Xorg', 'Host gaming', 'NVIDIA PRIME; desktop stays on the primary GPU', True)]
    states = {'running': 'running', 'shut off': 'shut off', 'paused': 'paused', 'in shutdown': 'shutting down'}
    for d in records:
        if d['pci']:
            info = states.get(d['state'], d['state'])
            live_gpu = set(d['live_gpu'])
            if live_gpu == set(BDFS):
                info += ' · GPU attached'
            elif live_gpu:
                info += f' · GPU partial ({len(live_gpu)}/{len(BDFS)})'
            else:
                info += ' · no GPU'
            if not d['eligible']:
                info += '; not configured for the selected GPU'
            rows.append((d['uuid'], d['name'], 'Virtual machine', info, d['eligible']))
    return rows


def operation_plan(target, records, xorg_attached):
    selected = next((d for d in records if d['uuid'] == target), None)
    if target not in ('none', 'xorg', 'cuda') and (selected is None or not selected['eligible']):
        raise Error('The selected VM must have all PCI functions of the selected NVIDIA GPU configured.')
    if selected and selected['state'] == 'shut off' and not selected.get('optional'):
        raise Error('Enable optional GPU setup for this VM before a one-time GPU boot.')
    owners = [d for d in records if d['live_gpu']]
    if selected and selected['live_gpu'] and set(selected['live_gpu']) == set(BDFS):
        return [], False
    stops = [d for d in owners if not (selected and d['uuid'] == target and selected.get('optional'))]
    if selected and selected['state'] != 'shut off' and selected not in stops and not (selected.get('optional') and selected['state'] == 'running'):
        stops.append(selected)
    if any(d['state'] != 'running' for d in stops):
        raise Error('First shut down the paused or transitioning GPU-owning VM manually.')
    return stops, (target == 'xorg' and not xorg_attached) or (target != 'xorg' and xorg_attached)


def operation_status(h, job, state, message, target):
    if OP_STATUS is None:
        print(message, flush=True)
        return
    h.atomic_json(OP_STATUS, {'job': job, 'state': state, 'message': message,
                             'target': target, 'gpu': GPU, 'time': time.time()}, mode=0o644)


def selection_worker(target, job, shutdown, restart):
    if os.geteuid() != 0:
        raise Error('Administrator authentication required')
    h = load_hook()
    h.assert_x11()
    if not hasattr(h, 'park'):
        raise Error('Install the GUI handoff update first.')
    operation_status(h, job, 'running', 'Checking current GPU attachment…', target)
    # Every libvirt operation below occurs outside the shared GPU lock.
    try:
        records = inventory()
        attached = bool(xorg_owners(h))
        stops, needs_restart = operation_plan(target, records, attached)
        selected = next((d for d in records if d['uuid'] == target), None)
        if stops and not shutdown:
            raise Error('Switching requires permission to shut down the current VM gracefully.')
        if needs_restart and not restart:
            raise Error('Switching requires permission to end graphical sessions.')
        fd = h.lock()
        try:
            h.topology()
            if selected and set(selected['live_gpu']) == set(BDFS):
                if any(h.driver(b) != 'vfio-pci' for b in BDFS):
                    raise Error('VM reports the GPU, but VFIO bindings do not match.')
                h.choose_target(target)
                operation_status(h, job, 'done', 'GPU is already attached to ' + selected['name'], target)
                return
            h.choose_target('blocked')  # No new guest may claim the GPU during a switch.
        finally:
            os.close(fd)
        for domain in stops:
            operation_status(h, job, 'running', 'Gracefully shutting down VM ' + domain['name'] + '…', target)
            virsh('shutdown', domain['uuid'])
            deadline = time.monotonic() + 120
            while virsh('domstate', domain['uuid']) != 'shut off':
                if time.monotonic() >= deadline:
                    raise Error('VM did not shut down within 120 seconds. No forced shutdown was performed.')
                time.sleep(1)
        if any(d['live_gpu'] for d in inventory()):
            raise Error('A VM owns the GPU again; switching has stopped.')
        now_attached = bool(xorg_owners(h))
        wanted_mode = 'on' if target == 'xorg' else 'off'
        needs_restart_now = h.xorg_mode() != wanted_mode or now_attached != (target == 'xorg')
        if needs_restart_now and not restart:
            raise Error('Xorg state changed; confirm graphical logout before retrying.')
        message = {'xorg': 'Attaching GPU to Xorg…', 'cuda': 'Attaching NVIDIA for CUDA without Xorg…'}.get(target, 'Releasing GPU for idle or VFIO use…')
        operation_status(h, job, 'running', message, target)
        worker('connect' if target == 'xorg' else 'disconnect', preserve_policy=True)
        if target == 'cuda':
            fd = h.lock()
            try:
                restore_host(h)
                h.run('/usr/sbin/modprobe', 'nvidia_uvm')
                if not h.module_loaded('nvidia_uvm'):
                    raise Error('The NVIDIA UVM module for CUDA did not load.')
                if h.xorg_mode() != 'off' or xorg_owners(h):
                    raise Error('Xorg still uses NVIDIA; CUDA mode was not applied.')
                h.choose_target('cuda')
            finally:
                os.close(fd)
            operation_status(h, job, 'done', 'CUDA ready: NVIDIA is host-bound; Xorg uses only the primary GPU.', target)
            return
        if target == 'xorg':
            fd = h.lock()
            try:
                h.choose_target('xorg')
            finally:
                os.close(fd)
            operation_status(h, job, 'done', 'GPU attached to Xorg. Sign in again to launch games.', target)
            return
        current = next((d for d in inventory() if d['uuid'] == target), None)
        if current and current.get('optional') and current['state'] == 'running':
            attach_running(target)
            operation_status(h, job, 'done', 'GPU attached to running VM ' + current['name'], target)
            return
        fd = h.lock()
        try:
            state = h.load()
            if state is not None and state['phase'] != 'parked':
                # A failed post-stop return may be retried only after ownership checks.
                h.release()
            h.park()
            h.choose_target(target)
        finally:
            os.close(fd)
        if target != 'none':
            current = next((d for d in inventory() if d['uuid'] == target), None)
            if current is None or not current['eligible'] or current['state'] not in ('shut off', 'running'):
                raise Error('The selected VM configuration or state changed.')
            operation_status(h, job, 'running', 'Starting VM ' + current['name'] + '…', target)
            if current.get('optional') and current['state'] == 'running':
                attach_running(target)
            else:
                start_optional(target)
            message = 'GPU attached to VM ' + current['name']
        else:
            message = 'GPU is idle, without a VM or Xorg attachment.'
        operation_status(h, job, 'done', message, target)
    except BaseException as exc:
        operation_status(h, job, 'error', str(exc), target)
        raise


def select_destination(target, job, shutdown, restart):
    if target not in ('none', 'xorg', 'cuda') and str(uuid.UUID(target)) != target:
        raise Error('Invalid target UUID')
    if str(uuid.UUID(job)) != job:
        raise Error('Invalid operation ID')
    if os.geteuid() != 0:
        raise Error('Use the GUI authorization dialog or run select as administrator.')
    h = load_hook()
    h.assert_x11()
    if not hasattr(h, 'park'):
        raise Error('Install the GUI handoff update first.')
    ensure_integration(vm=target not in ('none', 'xorg', 'cuda'))
    args = ['/usr/bin/python3', '-I', str(Path(__file__).resolve()), '--selection-worker', target, '--job-id', job]
    caller = os.environ.get('PKEXEC_UID')
    if caller:
        status_file(int(caller), job)
        args += ['--status-uid', caller]
    if shutdown:
        args.append('--shutdown-owner')
    if restart:
        args.append('--restart-session')
    run('/usr/bin/systemd-run', '--unit=nvidia-handoff', '--collect', '--property=Type=exec', *args)



def desktop_appearance(root):
    """Respect XFCE/Xft settings, with Tk defaults when desktop tools are absent."""
    dpi = float(root.winfo_fpixels('1i'))
    family, size = 'Sans', 11
    def query(*args):
        try:
            result = subprocess.run(args, capture_output=True, text=True, timeout=1.5)
            return result.stdout.strip() if result.returncode == 0 else ''
        except (OSError, subprocess.TimeoutExpired):
            return ''
    resource = query('/usr/bin/xrdb', '-query')
    match = re.search(r'(?m)^Xft\.dpi:\s*(\d+(?:\.\d+)?)\s*$', resource)
    if match and 48 <= float(match.group(1)) <= 384:
        dpi = float(match.group(1))
    preference = query('/usr/bin/xfconf-query', '-c', 'xsettings', '-p', '/Gtk/FontName')
    match = re.fullmatch(r'(.+?)\s+(\d+(?:\.\d+)?)', preference)
    if match and 6 <= float(match.group(2)) <= 32:
        family, size = match.group(1), round(float(match.group(2)))
    return max(48, min(384, dpi)), family, size


def configure_gui_style(root):
    from tkinter import ttk
    import tkinter.font as fonts
    dpi, family, size = desktop_appearance(root)
    root.tk.call('tk', 'scaling', dpi / 72)
    for name in ('TkDefaultFont', 'TkTextFont', 'TkMenuFont', 'TkHeadingFont', 'TkCaptionFont'):
        fonts.nametofont(name, root=root).configure(family=family, size=size)
    body = fonts.nametofont('TkDefaultFont', root=root)
    heading = fonts.nametofont('TkHeadingFont', root=root)
    heading.configure(weight='bold')
    title = body.copy()
    title.configure(size=size + 4, weight='bold')
    scale = dpi / 96
    px = lambda value: max(1, round(value * scale))
    style = ttk.Style(root)
    style.configure('Handoff.Treeview', font=body, rowheight=body.metrics('linespace') + px(12))
    style.configure('Handoff.Treeview.Heading', font=heading, padding=(px(10), px(7)))
    style.configure('Handoff.TButton', font=body, padding=(px(12), px(7)))
    style.configure('Handoff.Vertical.TScrollbar', arrowsize=px(14), width=px(16))
    style.configure('Handoff.Horizontal.TScrollbar', arrowsize=px(14), width=px(16))
    columns = (max(px(190), body.measure('CUDA without Xorg') + px(32)),
               max(px(190), body.measure('Virtual machine') + px(32)),
               max(px(310), heading.measure('Status / attachment') + px(32),
                   body.measure('PRIME, primary desktop GPU') + px(32)))
    return px, body, title, columns


def row_summary(row, current=None):
    summaries = {'none': 'VFIO, unattached', 'cuda': 'NVIDIA + UVM, no Xorg',
                 'xorg': 'PRIME, primary desktop GPU'}
    if row[0] == current and current in summaries:
        return {'none': 'Current · idle GPU', 'cuda': 'GPU attached · CUDA',
                'xorg': 'GPU attached · Xorg'}[current]
    if row[0] in summaries:
        return summaries[row[0]]
    if not row[4]:
        return row[3].split(';', 1)[0] + ' · GPU setup required'
    return row[3]


